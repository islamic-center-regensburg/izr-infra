# --------------------------------------
# make steps: the order of a trial run on a server (nothing is applied by it)
# --------------------------------------
.PHONY: steps

steps:
	@echo ''
	@echo 'Trial run on a server: ENV=$(ENV) PROJECT=$(PROJECT)'
	@echo 'This target only prints the steps. Every apply asks for confirmation.'
	@echo ''
	@echo '0. Prepare (once)'
	@echo '   cp .env.example .env   then set DOKPLOY_ENDPOINT, DOKPLOY_API_KEY, PLATFORM_NAME'
	@echo '   Copy each *.tfvars.example to its real name under terraform/ and fill it:'
	@echo '     bootstrap/projects/terraform.tfvars, bootstrap/infisical/service/terraform.tfvars'
	@echo '     bootstrap/secrets/$(ENV).tfvars, bootstrap/oidc/service/$(ENV).tfvars'
	@echo '     projects/$(PROJECT)/secrets/$(ENV).tfvars, projects/$(PROJECT)/apps/$(ENV).tfvars'
	@echo '   Needs terraform >= 1.11 and python3 on this machine.'
	@echo ''
	@echo '1. Check'
	@echo '   make preflight                      credentials and tools'
	@echo '   make validate PROJECT=$(PROJECT)    terraform validate of every root'
	@echo '   python3 -m unittest discover -s scripts    orchestrator tests'
	@echo ''
	@echo '2. Platform (first install only, then once per stage)'
	@echo '   make bootstrap-global               projects, Infisical, first admin, secrets project'
	@echo '   make bootstrap-env ENV=$(ENV)       platform secrets, PostgreSQL, Pocket ID'
	@echo '   Create the CMS client in Pocket ID and put its id and secret into'
	@echo '   projects/$(PROJECT)/secrets/$(ENV).tfvars (cms_oidc_client_id, cms_oidc_client_secret).'
	@echo ''
	@echo '3. Project: secrets, then databases, then apps'
	@echo '   make plan STACK=secrets ENV=$(ENV) PROJECT=$(PROJECT)    review the plan'
	@echo '   make project-secrets ENV=$(ENV) PROJECT=$(PROJECT)'
	@echo '     generates cms/SCREEN_TOKEN, cms/WEBSITE_TOKEN and cms/MCP_TOKEN in Infisical'
	@echo '   make plan STACK=apps ENV=$(ENV) PROJECT=$(PROJECT)       review: cms env has the 3 tokens'
	@echo '   make project-deploy ENV=$(ENV) PROJECT=$(PROJECT)        secrets, databases, apps, readiness'
	@echo '   (make full ENV=$(ENV) PROJECTS=$(PROJECT) runs steps 2 and 3 in one go)'
	@echo ''
	@echo '4. Verify on the server'
	@echo '   - Infisical /$(PROJECT)/cms holds SCREEN_TOKEN, WEBSITE_TOKEN, MCP_TOKEN (48 characters each)'
	@echo '   - CMS health: https://<cms domain>/server/health returns ok'
	@echo '   - CMS log shows: Applied revision 0001_initial, three active service users, MCP server enabled'
	@echo '   - Website and screen load their data (they use the private http://<cms app>:8055 URL)'
	@echo '   - MCP: POST https://<cms domain>/mcp with Authorization: Bearer <MCP_TOKEN> answers 200'
	@echo ''
	@echo '5. Deploy on merge (GitHub)'
	@echo '   auto_deploy is false: only the orchestrator and the GitHub workflow deploy.'
	@echo '   In Dokploy copy each app deploy webhook URL, then create the organization secrets'
	@echo '   DEPLOY_WEBHOOK_{CMS,WEBSITE,SCREEN}_{DEV,PROD}, limited to the matching repo.'
	@echo '   Merge a small change into dev; the Deploy workflow should call the hook.'
	@echo ''
	@echo '6. Production: repeat steps 2 to 4 with ENV=prod only after dev works.'
	@echo ''
	@echo 'Not applied here: destroy (make destroy STACK=... is explicit) and credential rotation.'
	@echo ''
